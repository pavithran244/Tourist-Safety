{
  "expo": {
    "name": "Tourist Safety",
    "slug": "tourist-safety",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "touristsafety",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.touristsafety.monitoring",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },

    "web": {
      "bundler": "metro"
    },

    "plugins": [
      "expo-router",
      "expo-location"
    ]
  }
}
